# Copy this file to backend/.env and fill in your own values.
# All values below are FAKE placeholders.

# Coinbase API credentials (used to read prices; no orders are ever placed).
COINBASE_API_KEY=organizations/your-org-id/apiKeys/your-key-id
COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\nyour-private-key\n-----END EC PRIVATE KEY-----\n

# NewsAPI key (https://newsapi.org). Optional: without it the news sentiment score is 0.
NEWS_API_KEY=your-newsapi-key

# Comma-separated list of websites allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
